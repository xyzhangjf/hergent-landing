.pw-page{min-height:100vh;background:#f5f5f7;padding:48rpx 48rpx 40rpx}
.hd{margin-bottom:40rpx;padding:0 8rpx}
.hd-title{font-size:40rpx;font-weight:600;color:#1d1d1f}
.hd-sub{font-size:26rpx;color:#86868b;margin-top:12rpx;line-height:1.5}
.card{background:#fff;border-radius:24rpx;padding:40rpx 40rpx 32rpx;box-shadow:0 4rpx 24rpx rgba(0,0,0,.05)}
.field{margin-bottom:28rpx}
.label{font-size:26rpx;color:#3a3a3c;margin-bottom:12rpx;padding-left:4rpx}
.ipt{height:92rpx;border:1rpx solid #e5e5ea;border-radius:16rpx;padding:0 28rpx;font-size:30rpx;box-sizing:border-box;background:#fbfbfd}
.btn{height:92rpx;background:#06b6d4;color:#fff;font-size:32rpx;border-radius:16rpx;margin-top:8rpx}
.btn[disabled]{opacity:.5}
.btn.ghost{background:#f2f2f7;color:#3a3a3c;margin-top:20rpx}
.err{color:#ff3b30;font-size:26rpx;margin:4rpx 0 16rpx;text-align:center}
.tip{font-size:24rpx;color:#86868b;margin-top:32rpx;text-align:center;line-height:1.6}
