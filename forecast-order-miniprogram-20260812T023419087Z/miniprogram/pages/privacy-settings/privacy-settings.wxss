.ps-page{min-height:100vh;background:#f5f5f7;padding:40rpx 32rpx 60rpx}
.hd{margin-bottom:32rpx;padding:0 8rpx}
.hd-title{font-size:40rpx;font-weight:600;color:#1d1d1f}
.hd-sub{font-size:26rpx;color:#86868b;margin-top:12rpx}
.grp{background:#fff;border-radius:24rpx;margin-bottom:24rpx;overflow:hidden;box-shadow:0 4rpx 24rpx rgba(0,0,0,.04)}
.grp-t{font-size:24rpx;color:#86868b;padding:24rpx 32rpx 8rpx}
.row{display:flex;flex-direction:row;align-items:center;padding:28rpx 32rpx;border-top:1rpx solid #f2f2f7}
.grp-t + .row{border-top:none}
.row-main{flex:1;min-width:0;margin-right:20rpx}
.row-t{font-size:30rpx;color:#1d1d1f}
.row-s{font-size:24rpx;color:#86868b;line-height:1.6;margin-top:8rpx}
.row-arrow{font-size:36rpx;color:#c7c7cc;line-height:1}
.revoke{height:92rpx;line-height:92rpx;background:#fff;color:#ff3b30;font-size:30rpx;border-radius:24rpx;margin-top:8rpx}
.revoke::after{border:none}
.tip{font-size:24rpx;color:#86868b;line-height:1.7;margin-top:24rpx;padding:0 16rpx;text-align:center}
