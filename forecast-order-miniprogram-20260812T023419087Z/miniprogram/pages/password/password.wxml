<view class="pw-page">
  <view class="hd">
    <view class="hd-title">{{force ? '请设置新密码' : '修改密码'}}</view>
    <view class="hd-sub">{{force ? '首次登录需修改初始密码后才能开始使用' : '修改后其它设备需重新登录'}}</view>
  </view>

  <view class="card">
    <view class="field" wx:if="{{needOld}}">
      <view class="label">原密码</view>
      <input class="ipt" password placeholder="{{force ? '请输入初始密码' : '请输入当前密码'}}" value="{{oldPw}}" bindinput="onOld" />
    </view>
    <view class="field">
      <view class="label">新密码</view>
      <input class="ipt" password placeholder="至少 8 位，含数字和字母" value="{{newPw}}" bindinput="onNew" />
    </view>
    <view class="field">
      <view class="label">确认新密码</view>
      <input class="ipt" password placeholder="再次输入新密码" value="{{newPw2}}" bindinput="onNew2" />
    </view>

    <view class="err" wx:if="{{error}}">{{error}}</view>
    <button class="btn" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{force ? '设置并进入' : '确认修改'}}</button>
    <button class="btn ghost" wx:if="{{!force}}" bindtap="back">返回</button>
  </view>

  <view class="tip">密码至少 8 位，且需同时包含数字与字母</view>
  <view class="tip" wx:if="{{force}}">如忘记密码，可在登录页用管理员发放的重置码自助重置</view>
</view>
