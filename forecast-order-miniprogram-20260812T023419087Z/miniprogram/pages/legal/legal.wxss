/* 协议页共享样式（隐私政策 / 用户服务协议）
   两个页面各自的 wxss 仅 @import 本文件，避免长文排版样式重复维护。
   视觉口径与 password/forgot 页一致：#f5f5f7 底、白色卡片、24rpx 圆角、#06b6d4 主色。 */
.legal-page{min-height:100vh;background:#f5f5f7;padding:40rpx 40rpx 60rpx}
.legal-card{background:#fff;border-radius:24rpx;padding:48rpx 40rpx;box-shadow:0 4rpx 24rpx rgba(0,0,0,.05)}
.legal-h1{font-size:40rpx;font-weight:600;color:#1d1d1f;margin-bottom:16rpx}
.legal-meta{font-size:24rpx;color:#86868b;line-height:1.7;padding-bottom:24rpx;margin-bottom:8rpx;border-bottom:1rpx solid #e5e5ea}
.legal-lead{font-size:28rpx;color:#3a3a3c;line-height:1.8;margin:24rpx 0}
.legal-h2{font-size:32rpx;font-weight:600;color:#1d1d1f;margin:40rpx 0 12rpx}
.legal-h3{font-size:28rpx;font-weight:600;color:#3a3a3c;margin:24rpx 0 8rpx}
.legal-p{font-size:28rpx;color:#3a3a3c;line-height:1.85;margin:12rpx 0}
.legal-li{font-size:28rpx;color:#3a3a3c;line-height:1.85;margin:10rpx 0;padding-left:28rpx;position:relative}
.legal-li::before{content:"·";position:absolute;left:8rpx;color:#06b6d4;font-weight:600}
.legal-li-2{font-size:27rpx;color:#6b7280;line-height:1.8;margin:8rpx 0 8rpx 28rpx;padding-left:28rpx;position:relative}
.legal-li-2::before{content:"—";position:absolute;left:0;color:#c7c7cc}
.legal-b{color:#1d1d1f;font-weight:600}
.legal-note{background:#f0fdfa;border:1rpx solid #99f6e4;border-radius:12rpx;padding:20rpx 24rpx;font-size:26rpx;color:#0f766e;line-height:1.7;margin:20rpx 0}
.legal-foot{margin-top:48rpx;padding-top:24rpx;border-top:1rpx solid #e5e5ea;font-size:24rpx;color:#a1a1a6;line-height:1.7;text-align:center}
