.page{min-height:100vh;background:#f5f5f7;padding-bottom:180rpx}
.store-bar{display:flex;align-items:center;justify-content:space-between;background:#fff;padding:24rpx 32rpx;border-bottom:1rpx solid #e5e5ea}
.store-sel{display:flex;align-items:center}
.store-name{font-size:32rpx;font-weight:600;color:#1d1d1f}
/* v294：本人仓标识 —— 与门店区分（两者报的是不同的单：自提 vs 调拨） */
.store-kind-tag{font-size:20rpx;font-weight:500;color:#0e7490;background:#ecfeff;border:1rpx solid #a5f3fc;border-radius:6rpx;padding:2rpx 10rpx;margin-left:12rpx}
.store-arrow{font-size:24rpx;color:#06b6d4;margin-left:12rpx}
.store-count{font-size:26rpx;color:#86868b}
.search-bar{display:flex;align-items:center;gap:16rpx;padding:24rpx 32rpx 0}
.search-ipt{flex:1;background:#fff;border-radius:16rpx;height:88rpx;padding:0 28rpx;font-size:30rpx;border:1rpx solid #e5e5ea}
.search-clear{font-size:30rpx;color:#86868b;padding:0 8rpx}
/* ===== v266（2026-09-27）：筛选 chips（品牌 + 我的常报）=====
   放在搜索栏与列表标题之间 —— 与搜索同属"缩小范围"，且都在列表上方。
   ⚠️ 横向滚动用「nowrap 容器 + inline-flex 内容」这一经典组合，不用 `enable-flex`：
      那个属性在不同基础库上对 scroll-view 内部布局的接管程度并不一致。 */
.filter-bar{padding:20rpx 32rpx 0}
.filter-scroll{width:100%;white-space:nowrap}
.filter-chips{display:inline-flex;align-items:center;gap:14rpx}
.fchip{flex:0 0 auto;font-size:24rpx;line-height:1.4;padding:10rpx 24rpx;border-radius:28rpx;
  background:#fff;border:1rpx solid #e5e5ea;color:#1d1d1f}
/* 品牌选中态：靛蓝（与 .recent-chip 同族）—— 品牌维度只能选中一个 */
.fchip-on{background:#4338ca;border-color:#4338ca;color:#fff;font-weight:600}
/* 「我的常报」用**青色系**与品牌区分：两者可叠加（品牌 ∧ 常报），同色会被读成单选 */
.fchip-freq{background:#ecfeff;border-color:#a5f3fc;color:#0e7490;font-weight:600}
.fchip-freq-on{background:#06b6d4;border-color:#06b6d4;color:#fff;font-weight:600}
/* chip 上的条数：比"品牌名"淡一档，不抢主要信息 */
.fchip-n{font-size:22rpx;opacity:.72;margin-left:6rpx}
/* 全量铺开：列表标题 + 分页加载状态 */
.prod-head{display:flex;align-items:center;justify-content:space-between;padding:24rpx 32rpx 0}
.prod-head-t{font-size:28rpx;color:#1d1d1f;font-weight:600}
.prod-head-n{font-size:24rpx;color:#86868b}
.load-more{text-align:center;color:#86868b;font-size:26rpx;padding:32rpx 0}
.load-end{text-align:center;color:#c7c7cc;font-size:24rpx;padding:32rpx 0}
/* 期次窗口提示
   v227：三态 —— 「已过」用告警红；「未开始」是可行动作（先做样单、等开放），
   用信息蓝 —— 两者可做的事不同，颜色相同会让用户以为"都没救了"。 */
.period-warn{margin:16rpx 32rpx 0;background:#fef2f2;border:1rpx solid #fecaca;border-radius:14rpx;padding:18rpx 24rpx;font-size:26rpx;color:#b91c1c}
.period-warn-future{background:#eff6ff;border-color:#bfdbfe;color:#1d4ed8}
/* ⚠️ v227 补回被误删的 `.reported-note`：
   v224 删它的理由是"引用它的 `<view>` 是死代码"，但那个类其实被**两处**引用 ——
     · `wx:if="{{lastReported && !cartCount}}"`  ← 死（v224 已删该 view）
     · `wx:if="{{!periods.length}}"`            ← **活的**（"当前没有可报单的期次"）
   删 CSS 时只核对了其中一个引用 ⇒ 这句提示一直在**裸奔**（无边框/无底色/无字号约束）。
   补回，与 no-store-note 同族（都是"你现在做不了这件事，原因在别处"）。
   🔴 教训：删一条 CSS 前要 grep **全部**引用点，而不是只看自己正在改的那个。 */
.reported-note{margin:16rpx 32rpx 0;background:#fffbeb;border:1rpx solid #fde68a;border-radius:14rpx;padding:18rpx 24rpx;font-size:26rpx;color:#92400e;line-height:1.6}
/* v304（2026-09-28）：本期报单进度提醒条 —— 与 .reported-note 同族（amber 底），
   但它是**可行动的进度提示**（"还差几个没报"），故底色更暖一档 + 左侧色条，
   与"仅说明原因"的那几条（period-warn / reported-note）在视觉上区分开。
   色条用 CSS 画，不用 emoji / 符号图标（全站图标规范）。 */
.pending-bar{display:flex;align-items:stretch;margin:16rpx 32rpx 0;background:#fff7ed;border:1rpx solid #fed7aa;border-radius:14rpx;overflow:hidden}
.pending-accent{width:6rpx;background:#f59e0b;flex:none}
.pending-text{display:flex;flex-direction:column;padding:18rpx 24rpx;min-width:0;flex:1}
.pending-title{font-size:26rpx;color:#9a3412;font-weight:600;line-height:1.5}
.pending-sub{font-size:22rpx;color:#c2410c;line-height:1.5;margin-top:4rpx}
/* v318（2026-09-29）：未读通知条 —— 与 .pending-bar **同构**（左色条 + 两行文案 + 右侧箭头），
   但**换成青色系**：两条可能同屏（"该报单" 与 "有人改了我的量"），
   同色会被读成同一件事的两个状态；青色 = 品牌主色（与 .sample-bar / .store-kind-tag 同族），
   琥珀 = 待办紧迫感。颜色分工是这套样式唯一的表达职责，别改。
   ⚠️ 文字色必须与底色同族（#0e7490 / #0891b2 配 #ecfeff）：直接沿用 .pending-title 的
      橙字会导致"青底橙字"，看起来像渲染错误。 */
.msg-bar{display:flex;align-items:center;margin:16rpx 32rpx 0;background:#ecfeff;border:1rpx solid #a5f3fc;border-radius:14rpx;overflow:hidden}
.msg-accent{width:6rpx;align-self:stretch;background:#06b6d4;flex:none}
.msg-text{display:flex;flex-direction:column;padding:18rpx 24rpx;min-width:0;flex:1}
.msg-title{font-size:26rpx;color:#0e7490;font-weight:600;line-height:1.5}
.msg-sub{font-size:22rpx;color:#0891b2;line-height:1.5;margin-top:4rpx}
.msg-go{font-size:36rpx;color:#06b6d4;flex:none;padding:0 24rpx 0 8rpx;line-height:1}
/* v227（2026-09-21）：复制生成样单 —— 入口条 + 来源回执 */
.sample-bar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:16rpx 32rpx 0;background:#fff;border:1rpx dashed #a5f3fc;border-radius:14rpx;padding:18rpx 24rpx}
.sample-txt{font-size:24rpx;color:#86868b;flex:1;line-height:1.5}
.sample-go{font-size:26rpx;color:#06b6d4;font-weight:600;flex:0 0 auto}
.sample-info{display:flex;flex-direction:column;gap:6rpx;margin:12rpx 32rpx 0;background:#ecfeff;border:1rpx solid #a5f3fc;border-radius:14rpx;padding:18rpx 24rpx;position:relative}
.sample-info-t{font-size:24rpx;color:#0e7490;font-weight:600;line-height:1.5;padding-right:70rpx}
.sample-info-s{font-size:22rpx;color:#0891b2;line-height:1.5}
.sample-info-warn{color:#b45309}
.sample-info-x{position:absolute;top:14rpx;right:20rpx;font-size:22rpx;color:#86868b}
/* P0-1（2026-09-20）：空门店说明条 —— 与 period-warn 同族（都是「你现在做不了这件事，原因在别处」） */
.no-store-note{margin:16rpx 32rpx 0;background:#fffbeb;border:1rpx solid #fde68a;border-radius:14rpx;padding:18rpx 24rpx;font-size:26rpx;color:#92400e;line-height:1.7}
.no-store-lnk{display:block;margin-top:12rpx;color:#06b6d4;font-weight:600}
.prod-list{padding:16rpx 32rpx 0}
.prod-row{display:flex;align-items:center;justify-content:space-between;background:#fff;border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx;border:2rpx solid transparent}
.prod-row-on{background:#ecfeff;border-color:#a5f3fc}
.prod-info{flex:1;min-width:0;padding-right:16rpx}
.prod-name{font-size:30rpx;color:#1d1d1f;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.prod-spec{font-size:24rpx;color:#86868b;margin-top:6rpx}
.prod-meta{font-size:22rpx;color:#94a3b8;margin-top:6rpx}
/* v264c（2026-09-24）：均单目标浅色提示 —— 淡淡的青底 + 青字，与品牌色同族但**不抢眼**：
   商品名（#1d1d1f 30rpx）> 规格（#86868b）> 库存/日均（#94a3b8）> 本行（最轻）。
   为什么不做成徽章/加粗：它是**参考值**，不是警告；抢眼了会让人误以为必须照它报。 */
.prod-avg{display:inline-block;margin-top:6rpx;padding:2rpx 10rpx;border-radius:8rpx;
  background:#ecfeff;color:#0891b2;font-size:22rpx;line-height:1.5}
/* 行内填报：− / 输入框 / +（P2-6: 触控目标 60→76rpx≈38px，减少手抖误触） */
.qty-ctl{display:flex;align-items:center;gap:12rpx;flex:0 0 auto}
.qty-ctl .qty-btn{width:76rpx;height:76rpx;font-size:44rpx}
.qty-btn-off{color:#c7c7cc}
.qty-btn-add{background:#06b6d4;color:#fff}
.qty-input{width:112rpx;height:76rpx;text-align:center;background:#f2f2f7;border-radius:12rpx;font-size:30rpx;color:#1d1d1f}
.qty-input-on{background:#fff;border:1rpx solid #06b6d4;color:#0e7490;font-weight:600}
.qty-ph{color:#c7c7cc;font-weight:400}
.cart-title{font-size:28rpx;color:#1d1d1f;font-weight:600;padding:32rpx 32rpx 16rpx;display:flex;align-items:center;justify-content:space-between}
.cart-arrow{font-size:24rpx;color:#06b6d4;font-weight:400}
.cart-list{padding:0 32rpx}
.cart-row{display:flex;align-items:center;background:#fff;border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx;position:relative}
.cart-info{flex:1;min-width:0}
.cart-name{font-size:28rpx;color:#1d1d1f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cart-spec{font-size:22rpx;color:#86868b;margin-top:4rpx}
.cart-qty{display:flex;align-items:center;gap:16rpx}
.qty-btn{width:56rpx;height:56rpx;border-radius:12rpx;background:#f2f2f7;color:#06b6d4;font-size:36rpx;display:flex;align-items:center;justify-content:center}
.qty-val{font-size:28rpx;color:#1d1d1f;min-width:90rpx;text-align:center}
.cart-del{position:absolute;top:-14rpx;right:-10rpx;width:44rpx;height:44rpx;border-radius:50%;background:#ff3b30;color:#fff;font-size:24rpx;display:flex;align-items:center;justify-content:center;opacity:.9}
.empty{text-align:center;color:#86868b;font-size:26rpx;padding:40rpx 0}
.empty-txt{font-size:26rpx;color:#86868b;line-height:1.6;padding:0 60rpx}
.empty-sub{font-size:24rpx;color:#a1a1a6;margin-top:6rpx}
.retry-btn{display:inline-flex;align-items:center;margin-top:20rpx;padding:14rpx 44rpx;font-size:28rpx;color:#06b6d4;border:1rpx solid #06b6d4;border-radius:40rpx;background:#fff}
/* v224（2026-09-21）方案 A：底部固定区。
   ⚠️ 定位/边框/安全区**全部上提到 .bottom-dock**，提交栏本身不再 fixed ——
      若提交栏与结果卡各自 fixed、各算各的 bottom 偏移，必然出现「卡片压住按钮」或
      「按钮压在卡片上」，而且依赖"提交栏究竟多少 rpx"这个魔数（一改字体/适配就错位）。 */
.bottom-dock{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1rpx solid #e5e5ea;z-index:10;padding-bottom:env(safe-area-inset-bottom)}
.submit-bar{display:flex;align-items:center;justify-content:space-between;padding:20rpx 32rpx}
.submit-total{flex:1;min-width:0;font-size:26rpx;color:#1d1d1f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.total-num{font-size:40rpx;color:#ff9500;font-weight:700}
.submit-btn{background:#06b6d4;color:#fff;font-size:32rpx;border-radius:16rpx;padding:0 64rpx;height:88rpx;line-height:88rpx}
.submit-btn[disabled]{opacity:.5}

/* M10: 最近报单门店快捷入口 */
.recent-stores{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx;padding:16rpx 32rpx 0}
.recent-label{font-size:24rpx;color:#86868b}
.recent-chip{background:#eef2ff;color:#4338ca;font-size:24rpx;padding:8rpx 22rpx;border-radius:28rpx}

/* M11: 离线草稿补传横幅 */
.draft-banner{display:flex;align-items:center;justify-content:space-between;margin:16rpx 32rpx 0;background:#fff7ed;border:1rpx solid #fed7aa;border-radius:14rpx;padding:18rpx 24rpx}
.draft-txt{font-size:24rpx;color:#9a3412;flex:1}
.draft-acts{display:flex;align-items:center;gap:24rpx}
.draft-go{font-size:26rpx;color:#06b6d4;font-weight:600}
.draft-clear{font-size:26rpx;color:#86868b}

/* M9: 今日已报回执
   ⚠️ v224 删除 `.reported-note` 规则本身 —— 引用它的那个 `<view>` 是**死代码**
      （条件 `lastReported && !cartCount` 恒假，详见 fill.wxml 里的说明）。
      留着这条 CSS 会让人以为"页面上还有这么一个回执"，是下一轮排查的诱饵。
      它现在的能力由底部结果卡（方案 A）承担。 */

/* 2026-09-06 跨期次沿用：上次报单快照 / 本期已提交回执 */
.last-bar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:16rpx 32rpx 0;background:#ecfeff;border:1rpx solid #a5f3fc;border-radius:14rpx;padding:18rpx 24rpx}
.last-bar-done{background:#ecfdf5;border-color:#a7f3d0}
.last-txt{font-size:24rpx;color:#0e7490;flex:1;line-height:1.5}
.last-bar-done .last-txt{color:#047857}
.last-go{font-size:26rpx;color:#06b6d4;font-weight:600;flex:0 0 auto}
.last-go-plain{color:#86868b;font-weight:400}

/* P2-3: 断网横幅 */
.offline-banner{margin:16rpx 32rpx 0;background:#fef3c7;border:1rpx solid #fde68a;border-radius:14rpx;padding:16rpx 24rpx;font-size:26rpx;color:#92400e;text-align:center}

/* P2-7: 回到顶部
   v224：结果卡显示时该按钮由 wxml 侧 `&& !submitResult` 隐藏 —— 它是 fixed + z-index:20，
   会浮在 z-index:10 的结果卡**上面**把卡片顶部几行压住，而卡片正是此刻唯一要看的东西。 */
.back-top{position:fixed;right:24rpx;bottom:220rpx;width:84rpx;height:84rpx;border-radius:50%;background:rgba(6,182,212,.92);color:#fff;font-size:44rpx;display:flex;align-items:center;justify-content:center;z-index:20}

/* ================= v224（2026-09-21）：底部固定区三态（方案 A） =================
   三种状态**互斥且同位置**：结果卡 / 错误条 / 提交栏。这样"反馈"永远出现在
   用户刚操作过的那个位置，且不可能出现「按钮还在、到底成没成不知道」。 */
/* ① 提交成功结果卡 */
.result-bar{padding:24rpx 32rpx 20rpx;background:#ecfdf5}
.result-hd{display:flex;align-items:center;gap:12rpx}
.result-ic{width:40rpx;height:40rpx;border-radius:50%;background:#059669;color:#fff;font-size:24rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.result-title{font-size:30rpx;font-weight:600;color:#047857;flex:1}
.result-at{font-size:22rpx;color:#059669;flex:0 0 auto}
/* 单号：整行可点复制 */
.result-sid{display:flex;align-items:center;gap:16rpx;margin-top:16rpx;background:#fff;border:1rpx solid #a7f3d0;border-radius:12rpx;padding:14rpx 20rpx}
.result-sid-lb{font-size:24rpx;color:#86868b;flex:0 0 auto}
.result-sid-no{flex:1;font-size:36rpx;font-weight:700;color:#047857;letter-spacing:1rpx}
.result-sid-cp{font-size:24rpx;color:#06b6d4;font-weight:600;flex:0 0 auto}
.result-meta{font-size:24rpx;color:#047857;margin-top:14rpx}
.result-qty{font-size:26rpx;color:#065f46;font-weight:600;margin-top:4rpx}
.result-skip{font-size:22rpx;color:#b45309;margin-top:8rpx;line-height:1.5}
.result-acts{display:flex;gap:16rpx;margin-top:20rpx}
/* ② 提交失败错误条 */
.err-bar{padding:24rpx 32rpx 20rpx;background:#fef2f2}
.err-txt{font-size:26rpx;color:#b91c1c;line-height:1.6}
.err-acts{display:flex;gap:16rpx;margin-top:18rpx;justify-content:flex-end}
/* 通用按钮（结果卡 / 错误条共用，避免两套几乎相同的样式各自漂移） */
.dock-btn{height:80rpx;line-height:80rpx;text-align:center;border-radius:14rpx;font-size:28rpx;box-sizing:border-box}
.dock-btn-plain{background:#fff;color:#047857;border:1rpx solid #a7f3d0}
.dock-btn-main{background:#06b6d4;color:#fff;font-weight:600}
.result-acts .dock-btn{flex:1}
.err-bar .dock-btn{flex:0 0 auto;padding:0 44rpx;height:72rpx;line-height:72rpx}
.err-bar .dock-btn-plain{color:#b91c1c;border-color:#fecaca}
.err-bar .dock-btn-main{background:#dc2626}
/* 结果卡显示时加大页面底部留白 —— 否则列表末尾（含"已显示全部 N 项"）会被卡片永久遮住 */
.page-with-result{padding-bottom:660rpx}

/* v370（2026-10-03）：销量数据新鲜度提示条。
   与 .pending-bar（橙色 = 你该做什么）刻意**不同色**：这一条是"数据可信度说明"，
   不是待办 —— 用中性灰蓝，视觉层级低于进度条，避免销售把提示当成催单。 */
.fresh-bar{display:flex;align-items:stretch;margin:12rpx 32rpx 0;background:#f1f5f9;border:1rpx solid #cbd5e1;border-radius:14rpx;overflow:hidden}
.fresh-accent{width:6rpx;background:#94a3b8;flex:none}
.fresh-text{font-size:22rpx;color:#475569;line-height:1.5;padding:14rpx 24rpx;flex:1;min-width:0}
