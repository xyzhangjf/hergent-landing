<view class="page {{submitResult ? 'page-with-result' : ''}}">
  <!-- 门店选择 -->
  <view class="store-bar">
    <picker mode="selector" range="{{stores}}" range-key="name" value="{{storeIdx}}" bindchange="onStoreChange">
      <view class="store-sel">
        <text class="store-name">{{store.name || '选择门店'}}</text>
        <text class="store-arrow">▾</text>
      </view>
    </picker>
    <view class="store-count">{{cartCount}} 项</view>
  </view>

  <!-- A 方案：报单周期选择（按名称选，对齐到货窗口） -->
  <view class="store-bar">
    <picker mode="selector" range="{{periods}}" range-key="display" value="{{periodIdx}}" bindchange="onPeriodChange">
      <view class="store-sel">
        <text class="store-name">{{period.name || '选择报单周期'}}</text>
        <text class="store-arrow">▾</text>
      </view>
    </picker>
    <text class="store-count" wx:if="{{period.arrival_date}}">到货 {{period.arrival_date}}</text>
  </view>
  <view class="reported-note" wx:if="{{!periods.length}}">当前没有可报单的期次，请联系管理员建期次</view>
  <!-- v227（2026-09-21）：窗口状态由两态改**三态** —— 「尚未开始」≠「已过」。
       两者的可行动作完全不同：未开始 = 可以先做样单、等开放再提交；已过 = 只能求管理员重开。
       原实现只有「已过」一种说法，对未开始的期次是**把话说反了**（后端
       `forecast_open_periods_all()` 按 `status='open'` 返回，不带日期过滤 ⇒ 未来期次本就在列）。 -->
  <view class="period-warn" wx:elif="{{period.wstate === 'past'}}">该期次报单窗口（{{period.order_start}} ~ {{period.order_end}}）已过，提交将被拒绝</view>
  <view class="period-warn period-warn-future" wx:elif="{{period.wstate === 'future'}}">该期次 {{period.order_start}} 才开始报单 —— 现在可以先生成样单，开放后再提交</view>

  <!-- ================= v227（2026-09-21）：复制生成样单 =================
       需求：报单人可以先"照往期"生成一份样单，改或不改，再切到已开放的期次提交。
       · 入口**常驻**（不做成"有历史单才显示"）：否则每次进页都要多发一次请求才知道该不该
         显示；而"这个门店还没有可复制的往期单据"本身就是一句有效提示，点击时再说即可。
       · 完整交互与约束见 fill.js::genSample 的头注释（源 / 落点 / 不落库三条边界）。 -->
  <view class="sample-bar" wx:if="{{periods.length && !submitResult}}">
    <text class="sample-txt">把往期报过的单复制成本期样单，改完直接提交</text>
    <text class="sample-go" bindtap="genSample">复制生成样单</text>
  </view>
  <!-- 样单来源回执：说清「这些数从哪来」+「跟本期清单合不合」——
       后者直接决定用户下一步是"直接提交"还是"先改几个"。 -->
  <view class="sample-info" wx:if="{{sampleInfo}}">
    <text class="sample-info-t">样单来自「{{sampleInfo.name}}」· {{sampleInfo.count}} 项 / {{sampleInfo.qty}} 件</text>
    <text class="sample-info-s {{sampleInfo.outOfScope ? 'sample-info-warn' : ''}}">{{sampleInfo.outTip}}</text>
    <text class="sample-info-x" bindtap="dismissSample">收起</text>
  </view>
  
  <!-- P0-1（2026-09-20）：**空门店**必须给原因与解锁动作 —— 原先只有一个空选择器 + 提交时
       一句「请先选择报单门店」，用户与审核员都不知道该找谁、改哪里。 -->
  <view class="no-store-note" wx:if="{{storeEmpty}}">
    <text>你还没有被配置报单门店，因此无法提交。请让管理员在电脑上打开【预报订单管理 → 报单配置】，把你的门店加上。</text>
    <text class="no-store-lnk" bindtap="copyStoreHint">复制提示发给管理员</text>
  </view>

  <!-- M10: 最近报单门店快捷入口 -->
  <view class="recent-stores" wx:if="{{recentStores.length}}">
    <text class="recent-label">最近报单</text>
    <view class="recent-chip" wx:for="{{recentStores}}" wx:key="name" data-name="{{item.name}}" bindtap="pickRecent">{{item.name}}</view>
  </view>

  <!-- M11: 离线/失败草稿一键补传横幅 -->
  <view class="draft-banner" wx:if="{{pendingSubmit && cartCount}}">
    <text class="draft-txt">有未提交草稿（{{cartCount}} 项），联网后可补传</text>
    <view class="draft-acts">
      <text class="draft-go" bindtap="resumeDraft">提交</text>
      <text class="draft-clear" bindtap="clearCart">清空</text>
    </view>
  </view>

  <!-- 2026-09-06 跨期次沿用：本期已提交回执（绿色）
       v224：补上**单号** —— 这是用户在"我这一单到底报上没有"上最需要的那个凭据，
       而在此之前它只在"你重复提交了"的警告框里出现过一次（越需要越看不到）。 -->
  <view class="last-bar last-bar-done" wx:if="{{submittedInfo}}">
    <text class="last-txt">✓ 本期已报 {{submittedInfo.count}} 项 / {{submittedInfo.qty}} 件（{{submittedInfo.at}}）<text wx:if="{{submittedInfo.sid}}"> · 单号 {{submittedInfo.sid}}</text> · 内容已保留，可继续修改</text>
    <text class="last-go" bindtap="goSummary">查看我的报单</text>
  </view>
  <!-- 上次报单快照：当前为空 → 一键带入；已有内容 → 提示来源 -->
  <view class="last-bar" wx:elif="{{lastOrder}}">
    <text class="last-txt">上次「{{lastOrder.periodName}}」在 {{store.name}} 报了 {{lastOrder.count}} 项 / {{lastOrder.qty}} 件（{{lastOrder.at}}）</text>
    <text class="last-go" wx:if="{{!cartCount}}" bindtap="applyLastOrder">一键带入</text>
    <text class="last-go last-go-plain" wx:else bindtap="clearCart">清空重填</text>
  </view>

  <!-- ⚠️ v224 删除：此处原有一块「M9 今日已报回执」
         `<view class="reported-note" wx:if="{{lastReported && !cartCount}}">{{lastReported}}</view>`
       它是一条**永不显示的死代码**：`lastReported` 只在提交成功时被赋值，而同一段代码里
       明确写着「提交成功后**不再清空**购物车」⇒ 赋值那一刻 `cartCount` 必然 > 0 ⇒ 条件恒假；
       唯一能让数量归零的「清空重填」又会把 `lastReported` 一起清掉。
       ⇒ 用户在这个页面上**从来没有**看到过这条"最贴题"的回执（这正是"提交了看不出成没成"
       的直接成因之一）。已由底部结果卡（方案 A）取代 —— 它不会被数量或清空动作抹掉。 -->

  <!-- P2-3: 断网横幅 -->
  <view class="offline-banner" wx:if="{{offline}}">网络已断开，数据已存本机，恢复后自动补传</view>

  <!-- 搜索（仅用于对已铺开列表做过滤定位，不改变原搜索逻辑） -->
  <view class="search-bar">
    <input class="search-ipt" placeholder="搜商品名 / 条码（后 4 位也行）" value="{{kw}}" bindinput="onSearch" focus="{{autoFocus}}" />
    <text class="search-clear" wx:if="{{kw}}" bindtap="clearSearch">✕</text>
  </view>

  <!-- 可预报商品：v215 起 = **本期报单清单**（与 Web 端同源同序），滚动到底分页加载 -->
  <view class="prod-head">
    <text class="prod-head-t">本期可报商品</text>
    <text class="prod-head-n">{{kw ? '匹配 ' : '共 '}}{{total}} 项</text>
  </view>
  <view class="prod-list">
    <!-- 行内填报：直接在这一行填数量，已填行高亮；库存/日均辅助判断 -->
    <view class="prod-row {{item.qty ? 'prod-row-on' : ''}}" wx:for="{{products}}" wx:key="id">
      <view class="prod-info">
        <view class="prod-name">{{item.name}}</view>
        <view class="prod-spec">{{item.spec || ''}} · {{item.unit || '件'}}</view>
        <view class="prod-meta">库存 {{item.current_stock || 0}} · 日均 {{item.avg_daily_sales || 0}}</view>
      </view>
      <view class="qty-ctl">
        <view class="qty-btn {{item.qty ? '' : 'qty-btn-off'}}" data-id="{{item.id}}" bindtap="onQtyMinus">−</view>
        <input class="qty-input {{item.qty ? 'qty-input-on' : ''}}" type="number" value="{{item.qty || ''}}"
               placeholder="0" placeholder-class="qty-ph" data-id="{{item.id}}" bindinput="onQtyInput" />
        <view class="qty-btn qty-btn-add" data-id="{{item.id}}" bindtap="onQtyPlus">+</view>
      </view>
    </view>
    <!-- P2-2: 首屏加载占位 -->
    <view class="empty" wx:if="{{initialLoading}}">加载商品中…</view>
    <!-- P2-5: 首屏加载失败 → 错误视图 + 重试 -->
    <view class="empty" wx:elif="{{loadError}}">
      <view class="empty-txt">{{loadError}}</view>
      <view class="retry-btn" bindtap="reloadProducts">点此重试</view>
    </view>
    <!-- v215：空态分三种成因，文案必须不同 —— 「本期没配清单」要引导用户找管理员，
         「搜索没匹配」只需换个词，二者混在一起会让用户白等或白找。 -->
    <view class="empty" wx:elif="{{!products.length && !loadingMore}}">
      <block wx:if="{{kw}}">
        <view class="empty-txt">本期没有匹配「{{kw}}」的商品</view>
        <view class="empty-txt empty-sub">也可以清空搜索词，看本期的全部商品</view>
        <view class="retry-btn" bindtap="clearSearch">清空搜索</view>
      </block>
      <block wx:elif="{{periodEmpty}}">
        <view class="empty-txt">本期「{{period.name || ''}}」还没有配置报单商品清单</view>
        <view class="empty-txt empty-sub">本期的可报商品来自电脑端的导入模板，请让管理员导入后再报单</view>
        <view class="retry-btn" bindtap="copyPeriodHint">复制给管理员</view>
      </block>
      <block wx:else>
        <view class="empty-txt">本期还没有可报单的商品</view>
        <view class="empty-txt empty-sub">下拉可刷新重试</view>
      </block>
    </view>
  </view>
  <view class="load-more" wx:if="{{loadingMore}}">加载中…</view>
  <view class="load-end" wx:elif="{{!hasMore && products.length}}">已显示全部 {{total}} 项</view>

  <!-- 已选商品：默认收起，数量已在行内填报，此处仅作总览/删除 -->
  <view class="cart-title" bindtap="toggleCart">
    <text>本次预报 {{cartCount}} 项 · 共 {{cartQty}} 件</text>
    <text class="cart-arrow">{{cartOpen ? '收起 ▴' : '展开 ▾'}}</text>
  </view>
  <view class="cart-list" wx:if="{{cartOpen}}">
    <view class="cart-row" wx:for="{{cart}}" wx:key="key">
      <view class="cart-info">
        <view class="cart-name">{{item.name}}</view>
        <view class="cart-spec">{{item.spec || ''}}</view>
      </view>
      <view class="cart-qty">
        <view class="qty-btn" data-key="{{item.key}}" bindtap="minus">−</view>
        <view class="qty-val">{{item.qty}} {{item.unit}}</view>
        <view class="qty-btn" data-key="{{item.key}}" bindtap="plus">+</view>
      </view>
      <view class="cart-del" data-key="{{item.key}}" bindtap="removeItem">✕</view>
    </view>
    <view class="empty" wx:if="{{!cart.length}}">还没填数量，在上方商品行直接输入即可</view>
  </view>

  <!-- ================= v224（2026-09-21）：底部固定区（方案 A） =================
       为什么把三种状态放进**同一个**固定容器（而不是各自 fixed + 各自的 bottom 偏移）：
         · 反馈必须落在**视线的落点** —— 用户刚点的按钮在屏幕底部，回执就必须出现在屏幕底部；
         · 用同一个容器 = 三种状态**互斥且同一位置**，不可能出现"结果卡与提交按钮同时存在"
           （那正是原来看不出成没成的原因：按钮还在，用户就以为没提交成功）；
         · 也不依赖任何"提交栏高度是多少 rpx"的魔数（那种算法会在适配/字体变化时错位）。 -->
  <view class="bottom-dock">
    <!-- ① 提交成功结果卡：卡片在、提交按钮**不在**（想再报必须先点「继续修改」） -->
    <view class="result-bar" wx:if="{{submitResult}}">
      <view class="result-hd">
        <text class="result-ic">✓</text>
        <text class="result-title">{{submitResult.isUpdate ? '已更新这一单' : '提交成功'}}</text>
        <text class="result-at">{{submitResult.at}}</text>
      </view>
      <!-- 单号：整行可点复制 —— 用户要拿它去对账 / 报给主管 / 在列表里找回同一单 -->
      <view class="result-sid" bindtap="copySid">
        <text class="result-sid-lb">单号</text>
        <text class="result-sid-no">{{submitResult.sid || '—'}}</text>
        <text class="result-sid-cp">复制</text>
      </view>
      <view class="result-meta">{{submitResult.storeName}} · {{submitResult.periodName}}</view>
      <view class="result-qty">本次 {{submitResult.count}} 项 · 共 {{submitResult.qty}} 件</view>
      <view class="result-skip" wx:if="{{submitResult.skipScopeText}}">已自动跳过不属于本期的商品：{{submitResult.skipScopeText}}</view>
      <view class="result-skip" wx:if="{{submitResult.skipInactiveText}}">已自动跳过已停售商品：{{submitResult.skipInactiveText}}</view>
      <view class="result-acts">
        <view class="dock-btn dock-btn-plain" bindtap="backToEdit">继续修改</view>
        <view class="dock-btn dock-btn-main" bindtap="goSummary">查看我的报单</view>
      </view>
    </view>

    <!-- ② 提交失败错误条：可重试（网络/服务端）→ 给「重试提交」；不可重试（业务拒绝）
         → 只说原因、不给徒劳的重试按钮（重试一万次结果一样，给了反而是误导）。 -->
    <view class="err-bar" wx:elif="{{submitError}}">
      <view class="err-txt">{{submitError.msg}}</view>
      <view class="err-acts">
        <view class="dock-btn dock-btn-plain" bindtap="dismissSubmitError">知道了</view>
        <view class="dock-btn dock-btn-main" wx:if="{{submitError.retryable}}" bindtap="retrySubmit">重试提交</view>
      </view>
    </view>

    <!-- ③ 提交栏：正常态（结果卡不显示时才出现） -->
    <view class="submit-bar" wx:if="{{!submitResult}}">
      <view class="submit-total">{{cartCount}} 项 · {{cartQty}} 件 · {{store.name || '未选门店'}}</view>
      <button class="submit-btn" disabled="{{submitting}}" bindtap="submit">{{submitting ? '提交中…' : '提交预报'}}</button>
    </view>
  </view>

  <!-- P2-7: 回到顶部（滚动超一屏显示）
       v224：结果卡显示时隐藏 —— 它是 fixed + z-index:20，会浮在结果卡（z-index:10）上面，
       把卡片顶部几行压住；而卡片正是此刻唯一要看的东西。 -->
  <view class="back-top" wx:if="{{showTop && !submitResult}}" bindtap="backTop">↑</view>
</view>
