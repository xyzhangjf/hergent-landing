.page { padding: 24rpx; }
.hd { font-size: 32rpx; font-weight: 600; color: #1c1c1e; margin: 8rpx 4rpx 20rpx; }
.list { display: flex; flex-direction: column; gap: 20rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.card-hd { display: flex; justify-content: space-between; align-items: baseline; }
.card-store { font-size: 30rpx; font-weight: 600; color: #1c1c1e; }
.card-meta { font-size: 24rpx; color: #8e8e93; }
.ai-line { margin-top: 8rpx; font-size: 24rpx; color: #06b6d4; }
.items { margin: 16rpx 0; display: flex; flex-direction: column; gap: 12rpx; }
.item { display: flex; align-items: center; font-size: 28rpx; color: #333; }
.it-name { flex: 1; }
.it-qty { color: #1c1c1e; font-weight: 600; margin-left: 12rpx; }
.it-ai { color: #ff9500; font-size: 24rpx; margin-left: 12rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.btn { margin: 0; font-size: 26rpx; }
.approve { background: #06b6d4; color: #fff; }
.reject { background: #f2f2f7; color: #ff3b30; }
.empty, .noauth { text-align: center; color: #8e8e93; padding: 80rpx 0; font-size: 28rpx; }
.noauth-ic { font-size: 64rpx; margin-bottom: 16rpx; }
