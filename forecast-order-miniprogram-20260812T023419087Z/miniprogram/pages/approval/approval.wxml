<view class="page">
  <view class="hd">待审批预报单</view>

  <view class="noauth" wx:if="{{noAuth}}">
    <view class="noauth-ic">🔒</view>
    <view class="noauth-tip">仅管理员 / 老板 / 督导可审批预报单</view>
  </view>

  <view class="empty" wx:elif="{{!list.length && !loading}}">暂无待审批预报单</view>

  <view class="list" wx:else>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="card-hd">
        <view class="card-store">{{item.store_name}}</view>
        <view class="card-meta">{{item.order_date}} · {{item.user_name || ('员工'+item.user_id)}}</view>
      </view>
      <view class="ai-line" wx:if="{{item.confidence}}">AI 置信度 {{item.confidence}}% · 库存预警 {{item.stock_warn_count || 0}}</view>
      <view class="items">
        <view class="item" wx:for="{{item.items}}" wx:for-item="it" wx:key="index">
          <text class="it-name">{{it.product_name}} {{it.spec}}</text>
          <text class="it-qty">{{it.quantity}} {{it.unit}}</text>
          <text class="it-ai" wx:if="{{it.ai_suggested != null}}">AI {{it.ai_suggested}}</text>
        </view>
      </view>
      <view class="actions">
        <button class="btn reject" size="mini" loading="{{acting === item.id}}" bindtap="reject" data-id="{{item.id}}">驳回</button>
        <button class="btn approve" size="mini" loading="{{acting === item.id}}" bindtap="approve" data-id="{{item.id}}">通过并生成采购申请</button>
      </view>
    </view>
  </view>
</view>
