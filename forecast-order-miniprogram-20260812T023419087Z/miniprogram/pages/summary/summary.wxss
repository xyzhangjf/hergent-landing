.page{min-height:100vh;background:#f5f5f7;padding-bottom:60rpx}
.hd{padding:40rpx 32rpx 8rpx}
.hd-title{font-size:40rpx;font-weight:700;color:#1d1d1f}
.hd-sub{font-size:24rpx;color:#86868b;margin-top:8rpx}
.actions{display:flex;align-items:center;justify-content:space-between;padding:24rpx 32rpx 8rpx}
.date-btn{font-size:26rpx;color:#06b6d4;background:#e6f7fb;border-radius:12rpx;padding:12rpx 24rpx}
.copy-btn{font-size:26rpx;color:#fff;background:#06b6d4;border-radius:12rpx;padding:12rpx 32rpx;line-height:1.6}
.table{background:#fff;margin:16rpx 32rpx;border-radius:16rpx;overflow:hidden}
.tr{display:flex;padding:20rpx 24rpx;border-bottom:1rpx solid #f2f2f7}
.tr.th{background:#fafafa;font-weight:600;color:#3a3a3c;font-size:26rpx}
.td{font-size:26rpx;color:#1d1d1f}
.w1{flex:2;min-width:0}
.w2{flex:1;text-align:center}
.w3{flex:1;text-align:right}
.w4{flex:1.2;text-align:right}
.pname{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pspec{font-size:22rpx;color:#86868b;margin-top:4rpx}
.num{font-weight:600;color:#ff9500}
.ai-num{font-weight:600;color:#06b6d4}
.ai-num.less{color:#ff9500}
.ai-num.more{color:#06b6d4}
.ai-diff{font-size:20rpx;color:#86868b;margin-top:4rpx}
.ai-na{color:#c7c7cc}
.ai-hint{font-size:22rpx;color:#86868b;padding:0 40rpx;margin-top:-8rpx}
.empty{text-align:center;color:#86868b;font-size:26rpx;padding:80rpx 0}
.src-title{font-size:28rpx;font-weight:600;color:#1d1d1f;padding:24rpx 32rpx 12rpx}
.src-list{padding:0 32rpx}
.src-group{background:#fff;border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx}
.src-gname{font-size:28rpx;font-weight:600;color:#1d1d1f;margin-bottom:10rpx}
.src-item{display:flex;justify-content:space-between;font-size:25rpx;color:#3a3a3c;padding:6rpx 0}
.src-qty{color:#06b6d4;font-weight:500}
